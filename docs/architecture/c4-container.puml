@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Lindos – Container Diagram (C4 Level 2)

Person(user, "Mitarbeiter", "Spricht oder klickt mit Lindos.")

System_Boundary(desktop, "Lindos Desktop App – lokal, Tray Icon") {
    Container(tray, "Tray Shell", "Rust / native (rust-core)", "Systemtray-Icon, Fenster-Lifecycle, OS-Integration (GNOME, macOS)")
    Container(ui, "Adaptive UI", "WebView, inspiriert durch Claude Cowork & Home Assistant", "Dashboards, Thumbnail-Links, kontext­sensitive Ansichten")
    Container(adaptiveEngine, "Adaptive UI Engine", "Rust", "Lernt aus Nutzungs­signalen — generiert Dashboards & Thumbnails dynamisch (z.B. ‘woran gestern gearbeitet’, ‘benötigt Aufmerksamkeit’)")
    Container(voice, "Sprachsteuerung", "Lokale STT (Parakeet V3, via Handy) + TTS (Piper)", "Erkennt Befehle, spricht Antworten — vollständig offline")
    Container(localLLM, "Lokales LLM Runtime", "llama.cpp / ONNX Runtime", "Sofortige Antworten und UI-Adaption ohne Cloud-Roundtrip")
    Container(skills, "Skills Engine", "Rust Plugins / WASM", "Lokale Fertigkeiten: Datei­operationen, OS-Aktionen, Shortcuts, Automatisierungen")
    ContainerDb(localStore, "Local Store", "SQLite + Embeddings + Files", "Verlauf, Präferenzen, Aufmerksamkeits­signale, Vektor-Cache")
}

System_Boundary(server, "Agent Server – im Unternehmens­netz") {
    Container(agentCore, "Agent Orchestrator", "Service", "Plant Aufgaben, ruft Tools auf, führt autonom mehrstufige Workflows aus")
    Container(connectors, "Connector Registry", "MCP-Stil Tools", "Sichere Anbindung an alle Unternehmens­datenquellen")
    Container(serverLLM, "Server-LLM Backend", "Self-hosted oder vermittelt", "Stärkeres Modell für komplexes Reasoning, Tool-Use, lange Kontexte")
    ContainerDb(memory, "Agent Memory", "Vector DB + Event-Log", "Langzeit­gedächtnis, Aufgaben-Historie, Audit-Trail")
    Container(scheduler, "Task Scheduler", "Service", "Wiederkehrende & verzögerte Agent-Läufe (Cron, Trigger)")
}

System_Ext(email, "E-Mail / Kalender", "M365, Google Workspace")
System_Ext(files, "Dateispeicher", "SharePoint, Drive, Nextcloud, S3")
System_Ext(crm, "CRM")
System_Ext(erp, "ERP")
System_Ext(wiki, "Wiki / Wissensbasis", "Confluence, Notion")
System_Ext(tickets, "Ticketing / DevOps", "Jira, GitLab, GitHub")
System_Ext(chat, "Chat / Kollaboration", "Slack, Teams")

' --- User Interaktion ---
Rel(user, voice, "Spricht Befehle")
Rel(voice, user, "Spricht Antwort", "TTS")
Rel(user, ui, "Klickt, scrollt, schaut Dashboards")
Rel(ui, tray, "Fenster­steuerung, Notifications")

' --- Adaptive UI ---
Rel(ui, adaptiveEngine, "Beobachtet Nutzungs­signale")
Rel(adaptiveEngine, localStore, "Liest/schreibt Signale & Embeddings")
Rel(adaptiveEngine, ui, "Aktualisiert Dashboards, Thumbnails, Empfehlungen")

' --- Lokale Verarbeitung ---
Rel(voice, localLLM, "Intent-Erkennung")
Rel(ui, localLLM, "Quick Prompts, UI-Hinweise")
Rel(ui, skills, "Triggert lokale Skills")
Rel(skills, localStore, "Liest/schreibt")
Rel(localLLM, localStore, "RAG über lokale Embeddings")

' --- Delegation an Agent Server ---
Rel(ui, agentCore, "Delegiert komplexe / mehrstufige Aufgaben", "HTTPS / WebSocket, mTLS")
Rel(agentCore, ui, "Streamt Fortschritt & Ergebnis")
Rel(scheduler, agentCore, "Triggert geplante Läufe")

' --- Agent intern ---
Rel(agentCore, serverLLM, "Reasoning, Tool-Choice")
Rel(agentCore, connectors, "Tool-Aufrufe")
Rel(agentCore, memory, "Liest/schreibt Kontext")

' --- Datenquellen ---
Rel(connectors, email, "")
Rel(connectors, files, "")
Rel(connectors, crm, "")
Rel(connectors, erp, "")
Rel(connectors, wiki, "")
Rel(connectors, tickets, "")
Rel(connectors, chat, "")

SHOW_LEGEND()
@enduml
